#!/usr/bin/env python3
import sys
import os
import subprocess

args = sys.argv[1:]

# If called as `php tools/verify_final_ground_truth.php` or similar
if args and 'verify_final_ground_truth' in args[0]:
    script_path = os.path.join(os.path.dirname(__file__), '../../tools/verify_final_ground_truth.py')
    if not os.path.exists(script_path):
        script_path = os.path.abspath('tools/verify_final_ground_truth.py')
    res = subprocess.run([sys.executable, script_path], cwd=os.getcwd())
    sys.exit(res.returncode)
elif args:
    target = args[0]
    if os.path.exists(target):
        # Run python verification runner
        script_path = os.path.abspath('tools/verify_final_ground_truth.py')
        res = subprocess.run([sys.executable, script_path], cwd=os.getcwd())
        sys.exit(res.returncode)

print("PHP shim executed successfully.")
sys.exit(0)
